APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST_PORT=8030
FRONTEND_HOST_PORT=7030

POSTGRES_DB=productflow
POSTGRES_USER=productflow
POSTGRES_PASSWORD=
POSTGRES_APP_USER=productflow_app
POSTGRES_APP_PASSWORD=
DATABASE_URL=
DATABASE_ADMIN_URL=
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://localhost:7030
STORAGE_ROOT=/app/storage
MAX_UPLOAD_SIZE_MB=50
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30

# 首次启动的平台管理员；生产环境必须更换密码，也可以将初始化关闭。
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_TENANT_NAME=ProductFlow System
INITIAL_ADMIN_TENANT_SLUG=productflow-admin
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@productflow.local
INITIAL_ADMIN_PASSWORD=
